---
import EmptyJournal from '../components/EmptyJournal.astro';
import Base from '../layouts/Base.astro';
import { gallery } from '../data/gallery';
// 首页封面与相册首张共享数据，新增收藏后无需重复更新图片和文案。
const cover = gallery[0];

import { getNotes, url } from '../lib/notes';
const notes = await getNotes();
const latest = notes[0];
---
<Base><!-- 首页独立背景避免影响文章阅读页。 --><div class="home-atmosphere">
  <section class="hero wrap postcard-hero">
    <!-- 星屑仅作装饰，不进入阅读顺序，也不拦截按钮和图片的点击。 -->
    <div class="magic-dust" aria-hidden="true">
      {Array.from({ length: 20 }, (_, i) => <span class:list={['dust', { 'dust-star': i % 3 === 0 }]} style={`--x:${[44,53,65,80,94,48,71,88,57,97,50,61,76,91,46,68,84,96,55,73][i]}%;--y:${[24,82,14,88,29,62,91,12,42,69,36,72,48,57,95,26,78,18,55,8][i]}%;--drift:${i % 2 ? -48 : 44}px;--duration:${8 + i % 5 * 1.5}s;--delay:${-i * 2.3}s`}>{i % 3 === 0 ? '✧' : ''}</span>)}
      <!-- 两颗星持续绕行，装饰层不接收点击。 -->
      <span class="orbit-star orbit-star-one">✦</span>
      <span class="orbit-star orbit-star-two">✧</span>
    </div>
    <div class="hero-image"><img src={url('images/hero.jpg')} alt="银色长发的魔女，戴着宽檐帽，沐浴在柔和的粉紫色光线中" fetchpriority="high" width="1176" height="666" /><span class="image-caption">澈酱的游戏开发日志 · 旅途中的一帧</span></div>
    <div class="hero-copy"><div class="eyebrow"><span class="status-dot"></span> 一本关于代码与想象的手记</div><h1>魔法尚未<span>编译<span class="title-star">✧</span></span></h1><p>正在把想象中的世界，<br />一行一行写出来。</p><div class="hero-actions"><a class="button" href={url('notes/')}>翻开手记 <span>↗</span></a></div><div class="hero-tags">Unity 开发 <i>✦</i> 灵感实验 <i>✦</i> 旅途记录</div></div>
  </section>
  <!-- 封面直接衔接笔记列表，个人介绍通过导航中的关于页查看。 -->
  <section class="wrap journal"><div class="section-heading"><div><div class="eyebrow">新的篇章</div><h2>旅途中的新一页<span>✧</span></h2></div><a class="text-link" href={url('notes/')}>全部笔记 ↗</a></div>
    <!-- 最新篇突出呈现，其余按日期排序；整张入口可点击，示例标识继续保留。 -->
{latest ? <div class="home-editorial">
  <a class="latest-note" href={url('notes/' + latest.id + '/')}>
    <div class="latest-label"><span>最新一页</span><time datetime={latest.data.date}>{latest.data.dateKind === '导入日期' && '导入 · '}{latest.data.date.replaceAll('-', '.')}</time></div>
    <span class="latest-glyph" aria-hidden="true">✧</span>
    <div class="latest-content"><span class="latest-category">{latest.data.category}{latest.data.sample && ' · 示例笔记'}</span><h3>{latest.data.title}</h3><p>{latest.data.description}</p></div>
    <div class="latest-bottom"><span>从这一页开始阅读</span><span aria-hidden="true">↗</span></div>
  </a>
  <div class="recent-notes"><div class="recent-heading"><span>沿途的记录</span><span>{notes.length} 篇手记</span></div>
    {notes.slice(1, 4).map((note, index) => <a class="recent-note" href={url('notes/' + note.id + '/')}><span class="recent-number" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span><div><span class="recent-meta">{note.data.category} · <time datetime={note.data.date}>{note.data.dateKind === '导入日期' && '导入 · '}{note.data.date.replaceAll('-', '.')}</time>{note.data.sample && ' · 示例'}</span><h3>{note.data.title}</h3></div><span class="recent-arrow" aria-hidden="true">↗</span></a>)}
    <!-- 首页入口沿用归档页的主题名称，保持导航一致。 -->
    <a class="recent-archive" href={url('archive/')}><span>每一篇，都是走过的足迹。</span><span>查看沿途足迹 ↗</span></a>
  </div>
</div> : <EmptyJournal title="等待第一道魔法" description="空白的一页，留给下一次灵感。代码、尝试与发现，都会慢慢写在这里。" />}
  </section>

  <!-- 相册作为首页独立入口，竖图保留完整构图。 -->
  {cover && <section class="wrap gallery-home">
    <a class="gallery-invitation" href={url('gallery/')}>
      <div class="gallery-invitation-image"><img src={url(cover.thumbnail)} width={cover.width} height={cover.height} loading="lazy" decoding="async" alt={cover.alt} /></div>
      <div class="gallery-invitation-copy"><span class="eyebrow">魔女剪影 · 最新收藏</span><h2>{cover.title} <span aria-hidden="true">✧</span></h2><p>{cover.caption}</p><span class="gallery-invitation-link">翻开相册 <span aria-hidden="true">↗</span></span></div>
    </a>
  </section>}
</div></Base>
