---
import { render } from 'astro:content';
import ReaderTools from '../../components/ReaderTools.astro';
import Base from '../../layouts/Base.astro';
import NoteSidebar from '../../components/NoteSidebar.astro';
import { getNotes, url } from '../../lib/notes';
export async function getStaticPaths() { return (await getNotes()).map(note => ({ params: { id: note.id }, props: { note } })); }
const { note } = Astro.props;
const { Content, headings } = await render(note);
---
<Base title={note.data.title} description={note.data.description}><div class="wrap notebook-layout"><NoteSidebar currentId={note.id} /><div class="page-section notebook-content"><a class="text-link" href={url('notes/')}>← 返回全部笔记</a><header class="article-header"><div class="eyebrow">{note.data.category} · {note.data.date}</div><h1>{note.data.title}</h1><p class="lead">{note.data.description}</p><div class="tags">{note.data.tags.map(tag => <span>#{tag}</span>)}{note.data.unity && <span>Unity {note.data.unity}</span>}</div></header><div class="article-grid"><article class="prose">{note.data.sample && <div class="sample-notice">✧ 这是一篇用于预览排版的示例笔记，可替换为澈酱自己的开发记录。</div>}<Content /><div class="article-end">✦ 本次施法记录结束，下次旅途再见。</div></article><aside class="toc"><div class="eyebrow">本页目录</div>{headings.filter(h => h.depth <= 3).map(h => <a class:list={{ nested: h.depth === 3 }} href={`#${h.slug}`}>{h.text}</a>)}</aside></div></div></div><ReaderTools /></Base>
