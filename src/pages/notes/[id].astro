---
import { render } from 'astro:content';
import ReaderTools from '../../components/ReaderTools.astro';
import Base from '../../layouts/Base.astro';
import NoteSidebar from '../../components/NoteSidebar.astro';
import { getNotes, url } from '../../lib/notes';
export async function getStaticPaths() { return (await getNotes()).map(note => ({ params: { id: note.id }, props: { note } })); }
const { note } = Astro.props;
const { Content, headings } = await render(note);
// 与书架的日期倒序保持一致，边界不循环，也不将草稿加入翻页入口。
const orderedNotes = await getNotes();
// 同类按左侧分组规则匹配，排除自身与草稿，最多推荐三篇。
const groupOf = entry => entry.data.folder?.[0] || entry.data.category;
const currentGroup = groupOf(note);
const relatedNotes = orderedNotes.filter(entry => entry.id !== note.id && groupOf(entry) === currentGroup).slice(0, 3);
const notePosition = orderedNotes.findIndex(entry => entry.id === note.id);
const adjacentNotes = [
  { entry: orderedNotes[notePosition - 1], label: '上一篇', direction: 'previous' },
  { entry: orderedNotes[notePosition + 1], label: '下一篇', direction: 'next' },
].filter(item => item.entry && notePosition >= 0 && !relatedNotes.some(entry => entry.id === item.entry.id));
---
<Base title={note.data.title} description={note.data.description}><div class="wrap notebook-layout"><NoteSidebar currentId={note.id} /><div class="page-section notebook-content"><a class="text-link" href={url('notes/')}>← 返回全部笔记</a><!-- 分类与日期分层显示，让长标题与摘要成为阅读入口。 --><!-- 文件夹路径保留 Obsidian 层级，便于读者定位。 --><header class="article-header">{note.data.folder && <div class="note-breadcrumb"><a href={url('notes/?category=' + encodeURIComponent(note.data.folder[0]))}>{note.data.folder[0]}</a>{note.data.folder.slice(1).map(part => <span> / {part}</span>)}</div>}<div class="article-meta"><span class="article-category">{note.data.category}</span><time datetime={note.data.date}>{note.data.dateKind && note.data.dateKind + ' · '}{note.data.date}</time><span class="article-mark" aria-hidden="true">✧</span></div><h1>{note.data.title}</h1><p class="lead">{note.data.description}</p>{note.data.sourceNote && <p class="source-note">来自 Obsidian · {note.data.sourceNote}<br />原始学习记录，代码与结论尚未逐项验证。</p>}<div class="tags">{note.data.tags.map(tag => <span>#{tag}</span>)}{note.data.unity && <span>Unity {note.data.unity}</span>}</div></header><div class="article-grid"><article class="prose">{note.data.sample && <div class="sample-notice">✧ 这是一篇用于预览排版的示例笔记，可替换为澈酱自己的开发记录。</div>}<Content /><!-- 手记落款提供读完后的去向，装饰星不进入辅助阅读。 -->
<div class="article-end"><span class="article-end-star" aria-hidden="true">✧</span><div class="article-signoff"><p>本次施法记录结束，下次旅途再见。</p><span>澈酱 · 魔法尚未编译</span></div><a href={url('notes/')} class="article-return">返回全部笔记 <span aria-hidden="true">↗</span></a></div></article><!-- 翻页卡片放在正文之外，不计入正文阅读进度或章节目录。 --><aside class="toc" hidden={headings.filter(h => h.depth <= 3).length === 0}><details class="toc-disclosure" open><summary>本页目录 <small class="toc-count">{headings.filter(h => h.depth <= 3).length} 节</small><span>展开 / 收起</span></summary><div class="toc-links">{headings.filter(h => h.depth <= 3).map((h, index) => <a class:list={{ nested: h.depth === 3 }} href={`#${h.slug}`}><span class="toc-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{h.text}</span></a>)}</div></details></aside></div>
<!-- 同类笔记优先显示，与上下篇去重，避免短书架出现重复推荐。 -->
{relatedNotes.length > 0 && <section class="related-reading" aria-labelledby="related-title">
  <div class="related-heading"><div><span class="eyebrow">沿着同一条学习路线</span><h2 id="related-title">{currentGroup} · 继续探索</h2></div><a href={url('notes/?category=' + encodeURIComponent(currentGroup))}>查看本类全部 ↗</a></div>
  <div class="related-list">{relatedNotes.map((entry, index) => <a class="related-entry" href={url('notes/' + entry.id + '/')}><span class="related-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{entry.data.title}</h3><p>{entry.data.description}</p><span class="related-meta">{entry.data.sample ? '示例笔记 · ' : ''}{entry.data.dateKind === '导入日期' ? '导入 · ' : ''}<time datetime={entry.data.date}>{entry.data.date.replaceAll('-', '.')}</time></span></div><span class="related-arrow" aria-hidden="true">↗</span></a>)}</div>
</section>}
{adjacentNotes.length > 0 && <section class="next-chapter" aria-label="继续阅读">
  <div class="next-chapter-heading"><span aria-hidden="true">✧</span><div><span class="eyebrow">旅途还在继续</span><h2>再翻一页手记</h2></div><span class="chapter-line" aria-hidden="true"></span></div>
  <nav class="chapter-links" aria-label="相邻笔记">
    {adjacentNotes.map(({ entry, label, direction }) => <a class:list={['chapter-link', direction]} href={url('notes/' + entry.id + '/')}>
      <span class="chapter-direction"><span aria-hidden="true">{direction === 'previous' ? '↖' : '↗'}</span>{label}</span>
      <span class="chapter-category">{entry.data.category}{entry.data.sample && <small>示例笔记</small>}</span>
      <strong>{entry.data.title}</strong>
      <span class="chapter-date"><time datetime={entry.data.date}>{entry.data.date.replaceAll('-', '.')}</time><span aria-hidden="true">✧</span></span>
    </a>)}
  </nav>
</section>}
</div></div><ReaderTools /></Base>
