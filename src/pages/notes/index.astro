---
import Base from '../../layouts/Base.astro';
import NoteSidebar from '../../components/NoteSidebar.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getNotes } from '../../lib/notes';
const notes = await getNotes();
---
<Base title="全部笔记"><div class="wrap notebook-layout"><NoteSidebar /><section class="page-section notebook-content"><div class="eyebrow">THE SPELLBOOK</div><p id="folder-caption" class="folder-caption" hidden></p><h1 class="page-title">魔法手记<span>✧</span></h1><p class="lead">把一路上的灵感、尝试与收获，写在这里。</p>
  <div class="filters"><label class="search"><span>搜索笔记</span><input type="search" id="search" placeholder="搜索标题、摘要或标签…" /></label></div>
  <p class="result-count" id="count" aria-live="polite">共 {notes.length} 篇笔记</p><div class="cards notes-grid">{notes.map((note, index) => <NoteCard note={note} index={index} />)}</div><p id="empty" class="empty" hidden>暂时没有找到这道魔法，试试其他关键词。</p>
</section></div></Base>
<script>
  // 分类和搜索共同过滤，URL 保存分类以支持首页直达。
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-note]'));
  const input = document.querySelector<HTMLInputElement>('#search')!;
  let category = new URLSearchParams(location.search).get('category') || '全部';

  // 分组匹配包含全部子目录，与原有分类、搜索共同生效。
  let folder: string[] = [];
  try { const parsed = JSON.parse(new URLSearchParams(location.search).get('folder') || '[]'); if (Array.isArray(parsed) && parsed.every(p => typeof p === 'string')) folder = parsed; } catch {}
  const caption = document.querySelector<HTMLElement>('#folder-caption')!;
  caption.hidden = folder.length === 0;
  caption.textContent = folder.join(' / ');
  function filter() {
    const keyword = input.value.trim().toLowerCase();
    let count = 0;
    cards.forEach(card => { card.hidden = !(category === '全部' || card.dataset.category === category || JSON.parse(card.dataset.folder || '[]')[0] === category) || !card.dataset.search!.includes(keyword) || !folder.every((part, i) => JSON.parse(card.dataset.folder || '[]')[i] === part); if (!card.hidden) count++; });
    document.querySelector('#count')!.textContent = `共 ${count} 篇笔记`;
    (document.querySelector('#empty') as HTMLElement).hidden = count > 0;
  }
  input.addEventListener('input', filter);
  filter();
</script>

